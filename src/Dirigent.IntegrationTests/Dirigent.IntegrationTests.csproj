<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Always write a result file, so that a failure names itself without anyone having to have
      asked for a logger on the command line. A test that fails once in fifty runs is the one that needs this,
      and by the time it does, the run is over.
    -->
    <VSTestLogger>trx%3bLogFileName=last-run.trx</VSTestLogger>
    <VSTestResultsDirectory>TestResults</VSTestResultsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.8" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dirigent.TestBed\Dirigent.TestBed.csproj" />
    <!-- built so the tests have something to launch, but not referenced as an assembly -->
    <ProjectReference Include="..\Dirigent.TestApp\Dirigent.TestApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
