<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Dirigent.TestBed.Gen</AssemblyName>
    <RootNamespace>Dirigent.TestBed.Gen</RootNamespace>
    <Product>Dirigent</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dirigent.TestBed\Dirigent.TestBed.csproj" />
    <!-- built so a generated world has something to launch, but not referenced as an assembly -->
    <ProjectReference Include="..\Dirigent.TestApp\Dirigent.TestApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
